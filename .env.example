PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://agriportal:agriportal_secret@localhost:5432/agriportal?schema=public"
JWT_SECRET="super-secure-jwt-access-secret-32-chars-long"
JWT_REFRESH_SECRET="super-secure-jwt-refresh-secret-32-chars-long"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"
INGESTION_BUFFER_FLUSH_MS=300
INGESTION_BUFFER_BATCH_SIZE=50
OFFLINE_THRESHOLD_MINUTES=30
LOG_LEVEL="info"
